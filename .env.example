# Names only — never real values. Real keys go in ~/.config/ai-course-scrum/.env, outside the repo;
# `make doctor` reads that file, then ./.env, then the shell environment (which wins).
HF_TOKEN=
GROQ_API_KEY=
NVIDIA_API_KEY=

# Odoo — the scrum-bot user's own API key, never the admin key (SCRUM-002)
ODOO_URL=
ODOO_DB=
ODOO_LOGIN=
ODOO_API_KEY=
# off | dry | on — on needs supervisor sign-off (SCRUM-029)
ODOO_WRITE=dry

# Teams — Entra app registration for the Azure Bot (SCRUM-001)
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=
