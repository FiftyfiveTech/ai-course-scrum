# Local Odoo sandbox only (sandbox/odoo/docker-compose.yml, bound to 127.0.0.1).
# These are throwaway test values, not secrets. Used only by `make doctor-sandbox`,
# which exports them for that one command. Never source this into your shell profile:
# the course board client reads ODOO_URL / ODOO_DB too.
ODOO_URL=http://localhost:8069
ODOO_DB=sandbox
ODOO_LOGIN=scrum-bot
# Odoo accepts the password where an API key is expected; the sandbox bot uses that.
ODOO_API_KEY=scrum-bot-sandbox
ODOO_WRITE=dry
